# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- open-claude 运行时产物 / 历史记录 ----
# 47314 run 索引库与 run 数据纳入版本管理，不再整体忽略 sandbox；
# 仅忽略运行时依赖与敏感数据。
# 47313 web 会话 / 任务历史（敏感：含用户对话与上传文件）
open-claude/sandbox/.web_tasks.json*
open-claude/sandbox/.task_history/
open-claude/sandbox/.task_history.backup-*/
open-claude/sandbox/mission-*/
open-claude/sandbox/ontology-workspace-*/
# 47313 历史遗留模板/样例（非 run 数据）
open-claude/sandbox/*.csv
open-claude/sandbox/*.xlsx
open-claude/sandbox/本体建模/
# 运行时依赖
open-claude/sandbox/pylibs/
open-claude/sandbox/**/pylibs/
# SQLite WAL/SHM 伴随文件不随索引库提交
*.sqlite3-wal
*.sqlite3-shm
# 会话录制 / 历史对话记录
*.jsonl
.open-claude/

# ---- 本项目临时 / 输出目录 ----
output/
tmp/
ontology-agent-*.log

# ---- 本地配置 / 密钥 ----
.claude/
.env
.env.*
!.env.example
credentials.json
.standalone-modeling-api-key
.standalone-modeling-data-sources.json
CLAUDE.local.md

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo

# ---- 操作系统 ----
.DS_Store
Thumbs.db

# ---- Node ----
node_modules/
# The Python service serves this reproducible production bundle directly.
!frontend/dist/
!frontend/dist/**

# ---- 47314 run 索引库与 run 数据（纳入版本管理）----
# 只纳入 run 索引库（.runs.sqlite3 / .runs.json）；
# run 工作区与事件日志含用户上传业务数据与运行时产物，不纳入。
!open-claude/sandbox/standalone-modeling-runs/
!open-claude/sandbox/standalone-modeling-runs/.runs.json
!open-claude/sandbox/standalone-modeling-runs/.runs.sqlite3
open-claude/sandbox/standalone-modeling-runs/run_*/
